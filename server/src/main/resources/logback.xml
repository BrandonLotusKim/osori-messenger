<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
 로그 파일 자동 회전:
          - 콘솔 출력은 기존 그대로 유지 (개발/Docker 환경).
          - 파일 출력은 OSORI_LOG_FILE_ENABLED=true 일 때만 활성 (기본 false).
          - 파일 경로: OSORI_LOG_DIR (기본 ./logs) + osori-server.log
          - 회전: 10MB 단위 + 최대 5개 보존 (총 ~50MB).
    -->
    <property name="LOG_FORMAT" value="${OSORI_LOG_FORMAT:-text}" />
    <property name="LOG_FILE_ENABLED" value="${OSORI_LOG_FILE_ENABLED:-false}" />
    <property name="LOG_DIR" value="${OSORI_LOG_DIR:-./logs}" />
    <property name="text" value="STDOUT_TEXT" />
    <property name="json" value="STDOUT_JSON" />

    <appender name="STDOUT_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"osori-server"}</customFields>
        </encoder>
    </appender>

    <!-- 회전 파일 어펜더 — SizeAndTimeBasedRollingPolicy (10MB × 5개) -->
    <appender name="FILE_ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/osori-server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/osori-server.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>60MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="${${LOG_FORMAT}}" />
        <if condition='property("LOG_FILE_ENABLED").equalsIgnoreCase("true")'>
            <then>
                <appender-ref ref="FILE_ROLLING" />
            </then>
        </if>
    </root>

    <logger name="com.osori" level="DEBUG" />
    <logger name="io.ktor" level="INFO" />
</configuration>
