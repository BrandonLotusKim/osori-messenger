<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OsoriClient.Wpf</RootNamespace>
    <!--: PerMonitorV2 DPI awareness — 멀티 모니터 환경에서 모니터별 스케일 변경 시 즉시 재렌더. .NET 8 WPF 기본은 SystemAware 라 모니터 이동 시 흐려짐. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- v0.1 어셈블리 버전 명시 (기본 0.0.0.0 대신 실제 출시 버전). 인스톨러 in-place upgrade 시 비교용. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <Product>오소리 메신저</Product>
    <Company>BrandonLotusKim</Company>
    <Copyright>© 2026 BrandonLotusKim. MIT License.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OsoriClient.Core\OsoriClient.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <!--: UseWindowsForms 가 자동 추가하는 글로벌 using 을 제거. WPF 타입(Brush/Color/Control/KeyEventArgs/Application)과 모호 충돌 방지. WinForms 타입은 각 파일에서 alias 또는 fully-qualified 로 사용. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
