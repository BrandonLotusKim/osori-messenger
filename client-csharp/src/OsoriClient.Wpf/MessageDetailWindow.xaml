<Window x:Class="OsoriClient.Wpf.MessageDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="쪽지"
        Width="520" Height="560"
        MinWidth="440" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="쪽지"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1" x:Name="CloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기"
                        Click="CloseButton_OnClick">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- 헤더: From/To + 시각 + 제목 -->
        <Border Grid.Row="1" Padding="16,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="HeaderLine"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" x:Name="SentAtText"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontMeta}" />
                </Grid>
                <TextBlock x:Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 첨부파일 칩 (OC-D04) -->
        <Border Grid.Row="2" x:Name="AttachmentChip"
                Padding="16,10"
                Background="{StaticResource AttachmentPreviewBgBrush}"
                BorderBrush="{StaticResource AttachmentPreviewBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconAttach}" Fill="{StaticResource TextSecondaryBrush}" />
                </Viewbox>
                <TextBlock Grid.Column="1" x:Name="AttachmentStatusText"
                           Text="첨부파일 1개"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" x:Name="AttachmentDownloadButton"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,4" Height="28"
                        Click="AttachmentDownloadButton_OnClick"
                        AutomationProperties.AutomationId="MessageAttachmentDownloadButton">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconDownload}" Fill="{StaticResource TextPrimaryBrush}" />
                        </Viewbox>
                        <TextBlock Text="다운로드" FontSize="{StaticResource FontMeta}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 본문 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontBody}" />
        </ScrollViewer>

        <!-- 액션 -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 답장 / 전체회신 / 전달 (OC-D04, 우클릭 아님 — 상세창 액션바에 상시 노출) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="ReplyButton" Style="{StaticResource FlatIconButton}"
                            Width="32" Height="32" ToolTip="답장"
                            Click="ReplyButton_OnClick"
                            AutomationProperties.AutomationId="MessageReplyButton">
                        <Path Data="{StaticResource IconReply}" Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="ReplyAllButton" Style="{StaticResource FlatIconButton}"
                            Width="32" Height="32" ToolTip="전체회신"
                            Click="ReplyAllButton_OnClick"
                            AutomationProperties.AutomationId="MessageReplyAllButton">
                        <Grid Width="18" Height="18">
                            <Path Data="{StaticResource IconReply}" Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform" Margin="4,0,0,0" />
                            <Path Data="{StaticResource IconReply}" Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform" Margin="0,0,4,0" Opacity="0.6" />
                        </Grid>
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource FlatIconButton}"
                            Width="32" Height="32" ToolTip="전달"
                            Click="ForwardButton_OnClick"
                            AutomationProperties.AutomationId="MessageForwardButton">
                        <Path Data="{StaticResource IconForward}" Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform" Width="18" Height="18" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="StatusText"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontMeta}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="DeleteButton" Content="삭제"
                        Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                        Click="DeleteButton_OnClick" />
                <Button Grid.Column="3" Content="닫기"
                        Style="{StaticResource PrimaryButton}"
                        Click="CloseButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
