<Application x:Class="OsoriClient.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/TitleBar.xaml" />
                <ResourceDictionary Source="Themes/ScrollBar.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- SystemColors 글로벌 오버라이드 — ListBox/TreeView/ScrollViewer 등 default ControlTemplate 이
                 SystemColors.* 직접 lookup 해서 흰 배경/검정 글자가 됨. 다크 톤으로 강제. -->
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1F2024" />
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2A2C30" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF2A2C30" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF2A2C30" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF36383D" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF50535A" />
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#FF36383D" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF353A40" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF353A40" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF1F2024" />
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF7A7C82" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#FF36383D" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionBrushKey}" Color="#FF18191C" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#FF2A2C30" />

            <!-- 설정 "글꼴 크기"가 바꾸는 본문 글자 크기(대화 말풍선·입력칸·쪽지 본문). App.ApplyFontSetting 이 갱신한다. -->
            <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ChatFontSize">13</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
