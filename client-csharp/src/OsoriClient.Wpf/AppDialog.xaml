<Window x:Class="OsoriClient.Wpf.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="오소리 메신저" Width="420" MinHeight="170"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <!-- 공통 보조 창: 다른 창과 같은 커스텀 타이틀바(다크) + 내용 높이에 맞춰 늘어나 버튼이 잘리지 않음.
         시스템 MessageBox / 코드로 만든 흰 타이틀바 창을 대신한다. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Data="{StaticResource IconLogo}" Fill="{StaticResource BrandBrush}" />
                    </Viewbox>
                    <TextBlock x:Name="TitleBarText" Text="오소리 메신저"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="TitleCloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기 (Esc)"
                        Click="TitleCloseButton_OnClick"
                        AutomationProperties.Name="닫기"
                        AutomationProperties.AutomationId="AppDialogCloseButton">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,18,20,16">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       AutomationProperties.AutomationId="AppDialogMessage" />
            <TextBlock x:Name="DetailText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontMeta}" />
            <WrapPanel x:Name="ButtonsPanel"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
