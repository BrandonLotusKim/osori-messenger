<Window x:Class="OsoriClient.Wpf.MessageComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="쪽지 쓰기"
        Width="520" Height="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="쪽지 쓰기"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1" x:Name="CloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기"
                        Click="CloseButton_OnClick">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- 수신자 + 제목 -->
        <StackPanel Grid.Row="1" Margin="14,12,14,0">
            <TextBlock Text="수신자 (쉼표로 구분)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RecipientsBox"
                         Style="{StaticResource AppTextBox}"
                         ToolTip="user1, user2 형식. 조직도 버튼으로 선택 가능."
                         AutomationProperties.AutomationId="MessageComposeRecipients" />
                <Button Grid.Column="1" Content="조직도..."
                        Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0"
                        Click="PickRecipients_OnClick" />
            </Grid>
            <TextBlock Text="제목" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource AppTextBox}"
                     Margin="0,0,0,8"
                     MaxLength="200"
                     AutomationProperties.AutomationId="MessageComposeTitle" />
        </StackPanel>

        <!-- 본문 -->
        <Grid Grid.Row="2" Margin="14,0,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="본문" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" x:Name="BodyBox"
                     Style="{StaticResource AppTextBox}"
                     Height="Auto"
                     VerticalContentAlignment="Top"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MaxLength="10000"
                     AutomationProperties.AutomationId="MessageComposeBody" />
        </Grid>

        <!-- 액션 -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontMeta}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="취소"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="CancelButton_OnClick" />
                <Button Grid.Column="3" x:Name="SendButton" Content="보내기"
                        Style="{StaticResource PrimaryButton}"
                        Click="SendButton_OnClick"
                        AutomationProperties.AutomationId="MessageComposeSend" />
            </Grid>
        </Border>
    </Grid>
</Window>
