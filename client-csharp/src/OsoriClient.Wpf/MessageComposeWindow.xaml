<Window x:Class="OsoriClient.Wpf.MessageComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="쪽지 쓰기"
        Width="520" Height="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="쪽지 쓰기"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1" x:Name="CloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기"
                        Click="CloseButton_OnClick"
        AutomationProperties.Name="닫기">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- 수신자 + 제목 -->
        <StackPanel Grid.Row="1" Margin="14,12,14,0">
            <TextBlock Text="받는 사람" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 칩 입력: 받는 사람마다 칩(이름 + ×), 끝에 ID 입력칸. Enter/쉼표/스페이스로 칩 추가, 빈 칸에서 Backspace 로 마지막 칩 삭제 -->
                <Border Grid.Column="0" x:Name="RecipientsFrame"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerSmall}"
                        Padding="10,3"
                        MinHeight="{StaticResource InputHeight}"
                        MaxHeight="96"
                        Cursor="IBeam"
                        MouseLeftButtonDown="RecipientsFrame_OnMouseLeftButtonDown">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel VerticalAlignment="Center">
                            <ItemsControl x:Name="RecipientChips" Focusable="False"
                                          AutomationProperties.Name="받는 사람 목록">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2,2,2" Margin="0,2,4,2"
                                                Cursor="Arrow"
                                                ToolTip="{Binding ToolTip}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                            <Setter Property="BorderBrush" Value="#E57373" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontMeta}" />
                                                <Button Content="×" Width="18" Height="18" Margin="4,0,0,0" Padding="0"
                                                        Style="{StaticResource FlatListButton}"
                                                        FontSize="12"
                                                        Tag="{Binding UserId}"
                                                        Click="RemoveChip_OnClick"
                                                        ToolTip="받는 사람에서 빼기"
                                                        AutomationProperties.Name="{Binding RemoveName}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="RecipientsBox"
                                     MinWidth="120"
                                     Margin="0,2,0,2"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     SelectionBrush="{StaticResource BrandBrush}"
                                     BorderThickness="0"
                                     ToolTip="아이디를 입력하고 Enter. 조직도 버튼으로 고를 수도 있습니다."
                                     PreviewKeyDown="RecipientsBox_OnPreviewKeyDown"
                                     TextChanged="RecipientsBox_OnTextChanged"
                                     LostKeyboardFocus="RecipientsBox_OnLostKeyboardFocus"
                                     AutomationProperties.AutomationId="MessageComposeRecipients"
                                     AutomationProperties.Name="받는 사람 입력" />
                        </WrapPanel>
                    </ScrollViewer>
                </Border>
                <Button Grid.Column="1" Content="조직도..."
                        Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0"
                        VerticalAlignment="Top"
                        Click="PickRecipients_OnClick"
                        AutomationProperties.Name="조직도에서 받는 사람 고르기" />
            </Grid>
            <TextBlock Text="제목" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource AppTextBox}"
                     Margin="0,0,0,8"
                     MaxLength="200"
                     AutomationProperties.AutomationId="MessageComposeTitle"
        AutomationProperties.Name="제목" />
        </StackPanel>

        <!-- 본문 -->
        <Grid Grid.Row="2" Margin="14,0,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="본문" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" x:Name="BodyBox"
                     Style="{StaticResource AppTextBox}"
                     Padding="10,6"
                     Height="Auto"
                     VerticalContentAlignment="Top"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MaxLength="10000"
                     AutomationProperties.AutomationId="MessageComposeBody"
        AutomationProperties.Name="본문" />
        </Grid>

        <!-- 액션 -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- SecondaryButton 템플릿은 문자열 Content 만 그린다 -->
                    <Button x:Name="AttachButton"
                            Content="📎 첨부"
                            MinWidth="80"
                            Style="{StaticResource SecondaryButton}"
                            Click="AttachButton_OnClick"
                            ToolTip="파일 첨부 (1개, 32MB 이하)"
                            AutomationProperties.AutomationId="MessageComposeAttach"
                            AutomationProperties.Name="파일 첨부" />
                    <Border x:Name="AttachmentChip" Visibility="Collapsed"
                            Margin="8,0,0,0" CornerRadius="10" Padding="8,2,2,2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AttachmentNameText" VerticalAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       FontSize="{StaticResource FontMeta}"
                                       AutomationProperties.AutomationId="MessageComposeAttachmentName" />
                            <Button Content="×" Width="18" Height="18" Margin="4,0,0,0" Padding="0"
                                    Style="{StaticResource FlatListButton}" FontSize="12"
                                    Click="RemoveAttachment_OnClick"
                                    ToolTip="첨부 빼기"
                                    AutomationProperties.Name="첨부 빼기" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="StatusText"
                           Margin="10,0,8,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontMeta}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="취소"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="CancelButton_OnClick" />
                <Button Grid.Column="3" x:Name="SendButton" Content="보내기"
                        Style="{StaticResource PrimaryButton}"
                        Click="SendButton_OnClick"
                        AutomationProperties.AutomationId="MessageComposeSend" />
            </Grid>
        </Border>
    </Grid>
</Window>
