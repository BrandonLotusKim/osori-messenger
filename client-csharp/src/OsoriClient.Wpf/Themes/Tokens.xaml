<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════
         오소리 메신저 디자인 토큰 (공용)
         ═══════════════════════════════════════════════════════════ -->

    <!-- ─── 브랜드/기본 (다크 + 노랑 포인트) ─── -->
    <Color x:Key="Brand">#FFFEE500</Color>             <!-- 카톡 노랑 — 메인 액센트 -->
    <Color x:Key="BrandHover">#FFFFD600</Color>        <!-- 진한 노랑 — hover -->
    <Color x:Key="BrandAccent">#FFFFF176</Color>       <!-- 밝은 노랑 — 그라디언트 끝 -->

    <!-- ─── 표면 (다크) ─── -->
    <Color x:Key="Surface">#FF1F2024</Color>           <!-- 메인 다크 배경 -->
    <Color x:Key="SurfaceMuted">#FF2A2C30</Color>      <!-- 보조 표면(헤더/입력박스) -->
    <Color x:Key="SurfaceTitlebar">#FF18191C</Color>   <!-- 타이틀바 -->
    <Color x:Key="SidebarSelected">#FF3A3520</Color>   <!-- 노랑 톤 어두운 — 선택된 사이드바 -->

    <!-- ─── 경계/텍스트 (다크 위 가독) ─── -->
    <Color x:Key="Border">#FF36383D</Color>            <!-- 다크 경계선 -->
    <Color x:Key="BorderStrong">#FF50535A</Color>
    <Color x:Key="TextPrimary">#FFE8E8E8</Color>       <!-- 다크 위 주 텍스트 -->
    <Color x:Key="TextSecondary">#FFA8AAB0</Color>
    <Color x:Key="TextMuted">#FF9A9CA2</Color>         <!-- 보조 텍스트: #2A2C30 위 5.1:1, #1F2024 위 5.9:1 (기준 4.5:1) -->

    <!-- ─── 상태 (다크 위 보정 톤) ─── -->
    <Color x:Key="Error">#FFEF5350</Color>
    <Color x:Key="Success">#FF4ADE80</Color>
    <Color x:Key="Warn">#FFFFC107</Color>

    <!-- ─── Presence (다크 위 보정) ─── -->
    <Color x:Key="PresenceOnline">#FF4ADE80</Color>
    <Color x:Key="PresenceOffline">#FF7A7C82</Color>
    <Color x:Key="PresenceAway">#FFFBC02D</Color>
    <Color x:Key="PresenceDnd">#FFEF5350</Color>

    <!-- ─── 배지 (노랑 액센트) ─── -->
    <Color x:Key="UnreadBg">#FFFEE500</Color>          <!-- 노랑 — 카톡 패턴 -->
    <Color x:Key="UnreadFg">#FF1F2024</Color>          <!-- 노랑 위 다크 텍스트 -->

    <!-- ─── 배너 (다크 위 부드러운 톤) ─── -->
    <Color x:Key="BannerWarnBg">#FF3A2D1A</Color>
    <Color x:Key="BannerWarnFg">#FFFFC107</Color>
    <Color x:Key="BannerWarnBorder">#FF5A4520</Color>
    <Color x:Key="BannerErrorBg">#FF3A1F1F</Color>
    <Color x:Key="BannerErrorFg">#FFEF5350</Color>
    <Color x:Key="BannerSuccessBg">#FF1F3A24</Color>
    <Color x:Key="BannerSuccessFg">#FF4ADE80</Color>

    <!-- ─── 말풍선 (다크) ─── -->
    <Color x:Key="BubbleMine">#FFFEE500</Color>        <!-- 카톡 노랑 — 내 메시지 -->
    <Color x:Key="BubbleMineText">#FF1F2024</Color>    <!-- 노랑 위 다크 텍스트 — 내 메시지 본문 -->
    <Color x:Key="BubbleTheir">#FF2A2C30</Color>       <!-- 다크 회색 — 상대 -->
    <Color x:Key="BubbleTheirBorder">#FF36383D</Color>
    <Color x:Key="AttachmentPreviewBg">#FF3A3520</Color>
    <Color x:Key="AttachmentPreviewBorder">#FF5A4520</Color>

    <!-- ─── 메시지 상태 (다크 위 보정) ─── -->
    <Color x:Key="StatusSending">#FF7A7C82</Color>
    <Color x:Key="StatusDelivered">#FF4ADE80</Color>
    <Color x:Key="StatusRead">#FF60A5FA</Color>
    <Color x:Key="StatusQueued">#FFFFA726</Color>
    <Color x:Key="StatusFailed">#FFEF5350</Color>

    <!-- ═══════════════════════════════════════════════════════════
         Brush (색상을 쓰기 위한 SolidColorBrush)
         ═══════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Brand}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHover}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccent}" />
    <!-- 2026-09-17 추가 — 메인 조직도 탭에서 클릭/Ctrl+클릭으로 선택된 사람 행 배경(체크박스 대체) -->
    <SolidColorBrush x:Key="OrgMemberSelectedBrush" Color="{StaticResource Brand}" Opacity="0.28" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMuted}" />
    <SolidColorBrush x:Key="SurfaceTitlebarBrush" Color="{StaticResource SurfaceTitlebar}" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelected}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <!-- 어두운 배경 위 링크(받은 말풍선 등): #2A2C30 위 6.7:1 -->
    <SolidColorBrush x:Key="LinkOnDarkBrush" Color="#FF8AB4FF" />

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}" />

    <SolidColorBrush x:Key="PresenceOnlineBrush" Color="{StaticResource PresenceOnline}" />
    <SolidColorBrush x:Key="PresenceOfflineBrush" Color="{StaticResource PresenceOffline}" />
    <SolidColorBrush x:Key="PresenceAwayBrush" Color="{StaticResource PresenceAway}" />
    <SolidColorBrush x:Key="PresenceDndBrush" Color="{StaticResource PresenceDnd}" />

    <SolidColorBrush x:Key="UnreadBgBrush" Color="{StaticResource UnreadBg}" />
    <SolidColorBrush x:Key="UnreadFgBrush" Color="{StaticResource UnreadFg}" />

    <SolidColorBrush x:Key="BannerWarnBgBrush" Color="{StaticResource BannerWarnBg}" />
    <SolidColorBrush x:Key="BannerWarnFgBrush" Color="{StaticResource BannerWarnFg}" />
    <SolidColorBrush x:Key="BannerWarnBorderBrush" Color="{StaticResource BannerWarnBorder}" />
    <SolidColorBrush x:Key="BannerErrorBgBrush" Color="{StaticResource BannerErrorBg}" />
    <SolidColorBrush x:Key="BannerErrorFgBrush" Color="{StaticResource BannerErrorFg}" />
    <SolidColorBrush x:Key="BannerSuccessBgBrush" Color="{StaticResource BannerSuccessBg}" />
    <SolidColorBrush x:Key="BannerSuccessFgBrush" Color="{StaticResource BannerSuccessFg}" />

    <SolidColorBrush x:Key="BubbleMineBrush" Color="{StaticResource BubbleMine}" />
    <SolidColorBrush x:Key="BubbleMineTextBrush" Color="{StaticResource BubbleMineText}" />
    <SolidColorBrush x:Key="BubbleTheirBrush" Color="{StaticResource BubbleTheir}" />
    <SolidColorBrush x:Key="BubbleTheirBorderBrush" Color="{StaticResource BubbleTheirBorder}" />
    <SolidColorBrush x:Key="AttachmentPreviewBgBrush" Color="{StaticResource AttachmentPreviewBg}" />
    <SolidColorBrush x:Key="AttachmentPreviewBorderBrush" Color="{StaticResource AttachmentPreviewBorder}" />

    <SolidColorBrush x:Key="StatusSendingBrush" Color="{StaticResource StatusSending}" />
    <SolidColorBrush x:Key="StatusDeliveredBrush" Color="{StaticResource StatusDelivered}" />
    <SolidColorBrush x:Key="StatusReadBrush" Color="{StaticResource StatusRead}" />
    <SolidColorBrush x:Key="StatusQueuedBrush" Color="{StaticResource StatusQueued}" />
    <SolidColorBrush x:Key="StatusFailedBrush" Color="{StaticResource StatusFailed}" />

    <!-- ═══════════════════════════════════════════════════════════
         타이포/간격
         ═══════════════════════════════════════════════════════════ -->

    <!--: 맑은 고딕(한글) → Malgun Gothic 별칭 → Segoe UI(영문) → Segoe UI Emoji(이모지). 단계적 fallback. -->
    <FontFamily x:Key="AppFontFamily">맑은 고딕, Malgun Gothic, Segoe UI, Segoe UI Emoji</FontFamily>

    <sys:Double x:Key="FontTitle">22</sys:Double>
    <sys:Double x:Key="FontSection">16</sys:Double>
    <sys:Double x:Key="FontSubtitle">11</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontListTitle">13</sys:Double>
    <sys:Double x:Key="FontListPreview">12</sys:Double>
    <sys:Double x:Key="FontLabel">11</sys:Double>
    <sys:Double x:Key="FontMeta">11</sys:Double>
    <sys:Double x:Key="FontTimestamp">10</sys:Double>
    <sys:Double x:Key="FontButton">13</sys:Double>

    <sys:Double x:Key="InputHeight">32</sys:Double>
    <sys:Double x:Key="ButtonHeight">36</sys:Double>
    <sys:Double x:Key="TitleBarHeight">32</sys:Double>
    <sys:Double x:Key="TabRailWidth">56</sys:Double>
    <sys:Double x:Key="AvatarSizeLarge">40</sys:Double>
    <sys:Double x:Key="AvatarSizeMedium">36</sys:Double>
    <sys:Double x:Key="AvatarSizeSmall">32</sys:Double>
    <CornerRadius x:Key="CornerSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerMedium">6</CornerRadius>
    <CornerRadius x:Key="CornerLarge">8</CornerRadius>
    <CornerRadius x:Key="CornerBubble">12</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════
         공용 Style
         ═══════════════════════════════════════════════════════════ -->

    <!-- Primary Button (브랜드 노랑 + 다크 텍스트 — 카톡 패턴) -->
    <!-- 키보드 포커스 표시(공통): 다크 화면에서 기본 점선이 안 보여 노란 2px 테두리로 통일 -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="2" RadiusX="4" RadiusY="4"
                               Stroke="{StaticResource BrandBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="Foreground" Value="#FF1F2024" />
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="MinWidth" Value="100" />
        <!-- 템플릿이 Padding 을 반영하도록 — 긴 버튼 문구가 테두리에 붙거나 넘치지 않게 -->
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontButton}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerSmall}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderStrongBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button (외곽선) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontButton}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerSmall}">
                        <!-- 문자열뿐 아니라 아이콘+글자 같은 복합 Content 도 그리도록 ContentPresenter 사용
                             (예전 TextBlock Text 바인딩은 StackPanel Content 를 빈 버튼으로 그렸다) -->
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TreeViewItem 행 전체 폭 + 다크 selected 배경 (#353A40) -->
    <Style x:Key="AppTreeViewItem" TargetType="TreeViewItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="19" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 행 전체 폭 highlight Bd — Margin -1000 으로 좌측 무한 확장, Padding 1000 으로 컨텐츠 위치 보정 -->
                        <Border x:Name="Bd"
                                Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                Margin="-1000,0,0,0"
                                Padding="1000,4,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="19" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Width="16" Height="16"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Width="16" Height="16">
                                                <Path x:Name="Arrow"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                                      Fill="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 0 4 L 8 4 L 4 8 Z" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="16,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF2A2C30" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF353A40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FlatIconButton — Background/Hover 변화 없는 평탄한 아이콘 버튼 (헤더 아이콘 버튼용) -->
    <Style x:Key="FlatIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 예전엔 Focusable=False 라 Tab 키로 닿지 않았다. 키보드 사용자를 위해 포커스 허용 + 표시 -->
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        <Setter Property="BorderBrush" Value="#FFFFCDD2" />
    </Style>

    <!-- 2026-09-17 추가 — 카드/팝업 안에서 목록 행처럼 보이는 전폭 버튼(멤버 팝업의
         "대화상대 초대하기"/"그룹 채팅 나가기" 등). 배경 없다가 hover 시에만 살짝 밝아짐. -->
    <Style x:Key="FlatListButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowBg" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 표준 TextBox -->
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrandBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerSmall}">
                        <Grid>
                            <!-- 입력 힌트: Tag 에 문구를 넣으면 비어 있을 때 흐리게 보인다 -->
                            <TextBlock x:Name="Hint"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <!-- Padding 은 입력칸 내부(텍스트 뷰)에서 이미 적용된다. 여기서 Margin 으로 한 번 더 주면 글자가 두 배 안쪽에서 시작했다. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrandBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerSmall}">
                        <!-- Padding 은 입력칸 내부(텍스트 뷰)에서 이미 적용된다. 여기서 Margin 으로 한 번 더 주면 글자가 두 배 안쪽에서 시작했다. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBlock 스케일 -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSubtitle}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="MetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontMeta}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- 전역 기본 TextBlock — Foreground 는 inherit (Button Content wrap 등에서 색 강제 안 됨) -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>

    <!-- Window 글로벌 — TextElement.Foreground 흰 inherit. 모든 TextBlock 이 inherit 받음. -->
    <Style TargetType="Window">
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         보강: 그림자 / 추가 색상 / 아바타 팔레트 / 간격 / 두께
         (디자인 스펙 01_login_design / 02_main_design / 03_conversation_design 의
          누락분을 통합하여 모든 윈도우가 동일 토큰을 참조하게 함)
         ═══════════════════════════════════════════════════════════ -->

    <!-- ─── 그림자 (Card / Floating UI / Window) ─── -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="4"  ShadowDepth="1" Opacity="0.08" Color="#FF000000" />
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="8"  ShadowDepth="2" Opacity="0.12" Color="#FF000000" />
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#FF000000" />

    <!-- ─── 추가 의미 색 (다크 + 노랑) ─── -->
    <Color x:Key="NewMessageBadgeBg">#FFFEE500</Color>     <!-- 노랑 -->
    <Color x:Key="NewMessageBadgeFg">#FF1F2024</Color>     <!-- 노랑 위 다크 -->
    <Color x:Key="SystemMessageFg">#FF7A7C82</Color>
    <Color x:Key="DateSeparatorFg">#FF7A7C82</Color>
    <Color x:Key="SenderNameFg">#FFA8AAB0</Color>
    <Color x:Key="FileIconBg">#FF2A2C30</Color>
    <Color x:Key="SidebarAccent">#FFFEE500</Color>         <!-- 노랑 액센트 바 -->
    <Color x:Key="DangerBorder">#FF5A1F1F</Color>

    <SolidColorBrush x:Key="NewMessageBadgeBgBrush" Color="{StaticResource NewMessageBadgeBg}" />
    <SolidColorBrush x:Key="NewMessageBadgeFgBrush" Color="{StaticResource NewMessageBadgeFg}" />
    <SolidColorBrush x:Key="SystemMessageFgBrush"   Color="{StaticResource SystemMessageFg}" />
    <SolidColorBrush x:Key="DateSeparatorFgBrush"   Color="{StaticResource DateSeparatorFg}" />
    <SolidColorBrush x:Key="SenderNameFgBrush"      Color="{StaticResource SenderNameFg}" />
    <SolidColorBrush x:Key="FileIconBgBrush"        Color="{StaticResource FileIconBg}" />
    <SolidColorBrush x:Key="SidebarAccentBrush"     Color="{StaticResource SidebarAccent}" />
    <SolidColorBrush x:Key="DangerBorderBrush"      Color="{StaticResource DangerBorder}" />

    <!-- ─── 발신자 아바타 8색 해시 팔레트 (§10) ───
         사용자 ID 를 SHA1 → 첫 바이트 mod 8 → 이 인덱스 사용 -->
    <Color x:Key="AvatarPalette0">#FFE57373</Color>
    <Color x:Key="AvatarPalette1">#FFBA68C8</Color>
    <Color x:Key="AvatarPalette2">#FF7986CB</Color>
    <Color x:Key="AvatarPalette3">#FF4FC3F7</Color>
    <Color x:Key="AvatarPalette4">#FF4DB6AC</Color>
    <Color x:Key="AvatarPalette5">#FF81C784</Color>
    <Color x:Key="AvatarPalette6">#FFFFB74D</Color>
    <Color x:Key="AvatarPalette7">#FFA1887F</Color>

    <SolidColorBrush x:Key="AvatarPalette0Brush" Color="{StaticResource AvatarPalette0}" />
    <SolidColorBrush x:Key="AvatarPalette1Brush" Color="{StaticResource AvatarPalette1}" />
    <SolidColorBrush x:Key="AvatarPalette2Brush" Color="{StaticResource AvatarPalette2}" />
    <SolidColorBrush x:Key="AvatarPalette3Brush" Color="{StaticResource AvatarPalette3}" />
    <SolidColorBrush x:Key="AvatarPalette4Brush" Color="{StaticResource AvatarPalette4}" />
    <SolidColorBrush x:Key="AvatarPalette5Brush" Color="{StaticResource AvatarPalette5}" />
    <SolidColorBrush x:Key="AvatarPalette6Brush" Color="{StaticResource AvatarPalette6}" />
    <SolidColorBrush x:Key="AvatarPalette7Brush" Color="{StaticResource AvatarPalette7}" />

    <!-- ─── 간격 / 폼 / 리스트 / 말풍선 / 입력 영역 ─── -->
    <sys:Double x:Key="FieldGap">12</sys:Double>
    <sys:Double x:Key="GroupGap">20</sys:Double>
    <sys:Double x:Key="FormPadding">24</sys:Double>

    <sys:Double x:Key="ListItemHeight">64</sys:Double>
    <Thickness  x:Key="ListItemPadding">10,12,10,12</Thickness>

    <Thickness  x:Key="BubblePadding">10,12,10,12</Thickness>
    <sys:Double x:Key="BubbleMaxWidthRatio">0.70</sys:Double>
    <sys:Double x:Key="BubbleMinWidth">48</sys:Double>

    <sys:Double x:Key="MemberDrawerWidth">280</sys:Double>
    <sys:Double x:Key="MessageInputMinHeight">40</sys:Double>
    <sys:Double x:Key="MessageInputMaxHeight">160</sys:Double>

    <sys:Double x:Key="StatusBarHeight">28</sys:Double>
    <sys:Double x:Key="DrawerAnimationMs">200</sys:Double>

    <!-- ─── 폰트 굵기 토큰 ─── -->
    <FontWeight x:Key="WeightRegular">Normal</FontWeight>
    <FontWeight x:Key="WeightMedium">Medium</FontWeight>
    <FontWeight x:Key="WeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="WeightBold">Bold</FontWeight>

    <!-- ═══════════════════════════════════════════════════════════
         글로벌 컨트롤 스타일 — CheckBox / ListBox / ListBoxItem
         ═══════════════════════════════════════════════════════════ -->

    <!-- AppCheckBox: 브랜드 색 체크 표시, 13pt 라벨 -->
    <Style x:Key="AppCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="16" Height="16"
                                CornerRadius="3"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Stretch="Uniform" Margin="2"
                                  Stroke="#FF1F2024" StrokeThickness="2"
                                  Data="M 0 5 L 4 9 L 11 1"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppListBoxItem: 호버 / 선택 / 좌측 액센트 바 -->
    <Style x:Key="AppListBoxItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource ListItemPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource ListItemHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Accent" Width="3" HorizontalAlignment="Left"
                                Background="Transparent" />
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Margin="3,0,0,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource SidebarAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppListBox: 깔끔한 흰 배경 + 보더 -->
    <Style x:Key="AppListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppListBoxItem}" />
    </Style>

    <!-- 약식: ComboBox 색상/폰트만 통일. 풀 ControlTemplate 은 (LoginWindow 재설계) 시점에 작성 -->
    <Style x:Key="AppComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppProgressRing" TargetType="Control">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <!-- x:Name 필수 — 이 스타일을 쓰는 스피너가 동시에 2개 이상 뜨면
                                 이름 없는 RotateTransform 이 frozen 공유 객체로 최적화되어 크래시 -->
                            <RotateTransform x:Name="SpinAngle" Angle="0" />
                        </Grid.RenderTransform>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Path Data="M 12,2 A 10,10 0 1 1 5,19"
                              Stroke="{StaticResource BrandBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
