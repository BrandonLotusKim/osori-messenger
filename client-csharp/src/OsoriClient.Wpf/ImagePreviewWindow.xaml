<Window x:Class="OsoriClient.Wpf.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="이미지 미리보기"
        Width="720" Height="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TitleText" Text="이미지"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" x:Name="CloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기"
                        Click="CloseButton_OnClick">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Image Grid.Row="1" x:Name="PreviewImage"
               Stretch="Uniform"
               Margin="12" />

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="MetaText"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontMeta}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="탐색기에서 열기"
                        Style="{StaticResource SecondaryButton}"
                        Click="OpenInExplorerButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
