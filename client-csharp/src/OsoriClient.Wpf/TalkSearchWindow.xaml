<Window x:Class="OsoriClient.Wpf.TalkSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="메시지 검색" Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 커스텀 타이틀바 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Data="{StaticResource IconLogo}" Fill="{StaticResource BrandBrush}" />
                    </Viewbox>
                    <TextBlock Text="메시지 검색"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="TitleCloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기"
                        Click="TitleCloseButton_OnClick">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=TitleCloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, ElementName=TitleCloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="12">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="KeywordTextBox" AutomationProperties.AutomationId="KeywordTextBox" Style="{StaticResource AppTextBox}" Height="28" VerticalContentAlignment="Center" KeyDown="KeywordTextBox_OnKeyDown" />
                <Button Grid.Column="1" x:Name="SearchButton" AutomationProperties.AutomationId="SearchButton" Style="{StaticResource PrimaryButton}" Content="검색" Width="90" Height="28" Margin="8,0,0,0" Click="SearchButton_OnClick" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" x:Name="StatusTextBlock" AutomationProperties.AutomationId="StatusTextBlock" Style="{StaticResource MetaText}" Margin="0,8,0,0" Text="키워드를 입력하고 Enter 또는 [검색] 을 누르세요." />

            <ListBox x:Name="ResultsListBox" AutomationProperties.AutomationId="ResultsListBox" Style="{StaticResource AppListBox}" MouseDoubleClick="ResultsListBox_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold">
                                    <Run Text="{Binding FromUserId}" Foreground="{StaticResource BrandBrush}" />
                                    <Run Text=" → " Foreground="{StaticResource TextMutedBrush}" />
                                    <Run Text="{Binding ToUserId}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TimestampText}" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
