<Window x:Class="OsoriClient.Wpf.TalkSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:OsoriClient.Wpf.Behaviors"
        Title="대화 검색" Height="520" Width="640"
        KeyDown="Window_OnKeyDown"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 커스텀 타이틀바 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Data="{StaticResource IconLogo}" Fill="{StaticResource BrandBrush}" />
                    </Viewbox>
                    <TextBlock Text="대화 검색"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="TitleCloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기 (Esc)"
                        AutomationProperties.Name="닫기"
                        Click="TitleCloseButton_OnClick">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=TitleCloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, ElementName=TitleCloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="12">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="KeywordTextBox" AutomationProperties.AutomationId="KeywordTextBox" AutomationProperties.Name="대화 검색어" Tag="검색어 입력 후 Enter (↓ 로 결과 이동)" Style="{StaticResource AppTextBox}" Height="32" VerticalContentAlignment="Center" KeyDown="KeywordTextBox_OnKeyDown" />
                <Button Grid.Column="1" x:Name="SearchButton" AutomationProperties.AutomationId="SearchButton" Style="{StaticResource PrimaryButton}" Content="검색" Width="90" Height="32" Margin="8,0,0,0" Click="SearchButton_OnClick" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" x:Name="StatusTextBlock" AutomationProperties.AutomationId="StatusTextBlock" Style="{StaticResource MetaText}" Margin="0,8,0,0" Text="내가 참여 중인 대화방의 메시지를 찾습니다." />

            <Grid>
            <ListBox x:Name="ResultsListBox" AutomationProperties.AutomationId="ResultsListBox" AutomationProperties.Name="검색 결과" Style="{StaticResource AppListBox}" MouseDoubleClick="ResultsListBox_OnMouseDoubleClick" KeyDown="ResultsListBox_OnKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                    <!-- 두 Run 사이 줄바꿈은 공백 한 칸이 되어 SenderText 앞 공백과 겹치므로 한 줄에 붙여 쓴다 -->
                                    <Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource BrandBrush}" /><Run Text="{Binding SenderText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TimestampText}" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           behaviors:HighlightedText.Source="{Binding Text}" behaviors:HighlightedText.Keyword="{Binding Keyword}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 결과 없음 안내 -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SearchEmptyPanel">
                <TextBlock x:Name="EmptyTitleText" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="단어 일부만 넣거나(예: 배포 일정 → 배포) 띄어쓰기를 바꿔 다시 찾아 보세요.&#10;내가 나간 대화방의 메시지는 검색되지 않습니다." />
            </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
