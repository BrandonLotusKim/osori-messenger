<Window x:Class="OsoriClient.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="오소리 메신저"
        Height="640" Width="380"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <!-- 위: 32px 커스텀 타이틀바 / 본문: 로고 / Form / 자동로그인 / 서버 / 상태 -->
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 커스텀 타이틀바 (드래그 영역 + 닫기 버튼) — 본문과 동일 다크 톤 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 좌측: 로고 마이크로 + 타이틀 (MainWindow 타이틀바와 동일 서식) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <Path Data="{StaticResource IconLogo}"
                              Fill="{StaticResource BrandBrush}" />
                    </Viewbox>
                    <TextBlock Text="오소리 메신저"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontBody}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <!-- 우측: 최소화 + 닫기 버튼 (NoResize 라 최대화만 제외) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="최소화"
                            Click="MinimizeButton_Click"
        AutomationProperties.Name="최소화">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="{StaticResource IconMinimize}"
                                  Fill="{StaticResource TextSecondaryBrush}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="TitleCloseButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Tag="Close"
                            ToolTip="닫기"
                            Click="TitleCloseButton_OnClick"
        AutomationProperties.Name="닫기">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="{StaticResource IconClose}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TitleCloseButton}" Value="True">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, ElementName=TitleCloseButton}" Value="True">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 로고 영역 (큰 박스 + 타이틀) -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Border Width="100" Height="100" CornerRadius="24"
                    HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Brand}" Offset="0" />
                        <GradientStop Color="{StaticResource BrandAccent}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="🦦" FontSize="56"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" />
            </Border>
            <TextBlock Text="오소리 메신저"
                       FontFamily="{StaticResource AppFontFamily}"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,4" />
            <TextBlock Text="사내 소통을 시작하세요"
                       FontFamily="{StaticResource AppFontFamily}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Form (Card 없이 직접 노출, 카톡식) -->
        <StackPanel Grid.Row="2" Margin="32,0,32,0">
            <!-- 사용자 ID — TextBox (다크 일관성, 단순). RecentUserIds 드롭다운은 v0.2 폴리싱 -->
            <TextBox x:Name="UserIdCombo"
                     Style="{StaticResource AppTextBox}"
                     Height="44"
                     Padding="12,0"
                     Margin="0,0,0,8"
                     AutomationProperties.AutomationId="LoginUserIdCombo"
        AutomationProperties.Name="사용자 ID" />

            <PasswordBox x:Name="PasswordTextBox"
                         Style="{StaticResource AppPasswordBox}"
                         Height="44"
                         Padding="12,0"
                         AutomationProperties.AutomationId="LoginPasswordBox"
        AutomationProperties.Name="비밀번호" />

            <!-- 큰 로그인 버튼 (카톡 검정 패턴 — 다만 우리 Brand 색 사용) -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 간격은 링의 오른쪽 여백으로 — 고정 간격 열이면 링이 숨었을 때도 버튼이 입력칸보다 8px 들어가 정렬이 어긋난다 -->
                <Control x:Name="ConnectProgress"
                         Grid.Column="0"
                         Style="{StaticResource AppProgressRing}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         AutomationProperties.AutomationId="LoginConnectProgress" />
                <Button x:Name="ConnectButton"
                        Grid.Column="2"
                        Content="로그인"
                        Height="50"
                        Background="{StaticResource BrandBrush}"
                        Foreground="#FF1F2024"
                        FontFamily="{StaticResource AppFontFamily}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ConnectButton_OnClick"
                        AutomationProperties.AutomationId="LoginConnectButton">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderStrongBrush}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>

        <!-- 비밀번호 저장 + 자동 로그인 (버튼 아래, 카톡 위치) -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <!-- 2026-09-17 추가 — 자동 로그인과 별개로 "비밀번호만 저장"(자동 접속은 안 함,
                 다음 실행 시 비밀번호 칸만 미리 채워줌). 자동 로그인 체크박스 좌측에 배치. -->
            <CheckBox x:Name="RememberPasswordCheck"
                      Style="{StaticResource AppCheckBox}"
                      Content="비밀번호 저장"
                      FontSize="{StaticResource FontMeta}"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,16,0"
                      AutomationProperties.AutomationId="LoginRememberPasswordCheck" />
            <CheckBox x:Name="AutoLoginCheck"
                      Style="{StaticResource AppCheckBox}"
                      Content="자동 로그인"
                      FontSize="{StaticResource FontMeta}"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      AutomationProperties.AutomationId="LoginAutoCheck" />
        </StackPanel>

        <!-- 서버 설정 Expander (카톡엔 없지만 우리 메신저 특수 — 하단으로 이동) -->
        <Expander Grid.Row="4"
                  x:Name="ServerExpander"
                  Header="서버 설정"
                  FontSize="{StaticResource FontMeta}"
                  Foreground="{StaticResource TextSecondaryBrush}"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  Padding="32,8,32,12"
                  Margin="0,16,0,0"
                  AutomationProperties.AutomationId="LoginServerExpander">
            <StackPanel>
                <TextBlock Text="서버 호스트"
                           Style="{StaticResource LabelText}"
                           Margin="0,8,0,4" />
                <TextBox x:Name="HostTextBox"
                         Style="{StaticResource AppTextBox}"
                         Text="127.0.0.1"
                         Margin="0,0,0,8"
                         AutomationProperties.AutomationId="LoginHostBox"
        AutomationProperties.Name="서버 주소" />

                <TextBlock Text="포트"
                           Style="{StaticResource LabelText}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="PortTextBox"
                         Style="{StaticResource AppTextBox}"
                         Text="7071"
                         Margin="0,0,0,8"
                         AutomationProperties.AutomationId="LoginPortBox"
        AutomationProperties.Name="서버 포트" />

                <CheckBox x:Name="UseTlsCheckBox"
                          Content="wss 사용 (자체 서명 허용)"
                          FontSize="{StaticResource FontMeta}"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          AutomationProperties.AutomationId="LoginTlsCheck" />
            </StackPanel>
        </Expander>

        <!-- 상태 텍스트 (하단) -->
        <TextBlock Grid.Row="5"
                   x:Name="StatusTextBlock"
                   Text="대기 중"
                   FontFamily="{StaticResource AppFontFamily}"
                   FontSize="{StaticResource FontSubtitle}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="32,8,32,16"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LoginStatusText" />
    </Grid>
</Window>
