<Window x:Class="OsoriClient.Wpf.TalkWindow"
        xmlns:behaviors="clr-namespace:OsoriClient.Wpf.Behaviors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OsoriClient.Wpf"
        xmlns:converters="clr-namespace:OsoriClient.Wpf.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="대화"
        Height="668"
        Width="420"
        MinHeight="400"
        MinWidth="360"
        WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:BubbleMaxWidthConverter x:Key="BubbleMaxWidthConverter" />
        <DataTemplate x:Key="MessageBubbleTemplate">
            <Grid Margin="0,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Margin="0,6,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowDateSeparator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Height="1"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DateSeparatorFgBrush}"
                            Opacity="0.25" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DateSeparatorLabel}"
                               Foreground="{StaticResource DateSeparatorFgBrush}"
                               FontSize="{StaticResource FontMeta}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="2"
                            Height="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DateSeparatorFgBrush}"
                            Opacity="0.25" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Row.SenderLabel}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontMeta}"
                           Margin="40,4,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- 같은 사람이 이어 보낸 메시지(IsContinuation)는 이름을 반복하지 않는다 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Row.IsMine}" Value="False" />
                                        <Condition Binding="{Binding IsContinuation}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row.IsMine}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Row.IsMine}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- 이어 보낸 메시지: 아바타 자리만 남기고(정렬 유지) 숨김 -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Row.IsMine}" Value="False" />
                                            <Condition Binding="{Binding IsContinuation}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Row.SenderAvatarHex, FallbackValue=#BDBDBD}" />
                        </Border.Background>
                        <TextBlock Text="{Binding Row.SenderInitial}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,4,2" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Row.IsMine}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- 읽음 표시: 안 읽은 인원 수(노랑) 또는 "읽음"(흐리게). 방 메시지만 값이 있다 -->
                        <TextBlock Text="{Binding Row.ReadLabel}"
                                   FontSize="{StaticResource FontTimestamp}"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.Name="{Binding Row.ReadLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Row.HasUnread}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Row.ReadLabel}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Row.StatusIcon}"
                                   FontSize="{StaticResource FontTimestamp}"
                                   HorizontalAlignment="Right"
                                   ToolTip="{Binding Row.StatusToolTip}"
                                   AutomationProperties.Name="{Binding Row.StatusToolTip}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource StatusSendingBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Row.Status}" Value="Delivered">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDeliveredBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Row.Status}" Value="Queued">
                                            <Setter Property="Foreground" Value="{StaticResource StatusQueuedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Row.Status}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource StatusFailedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Row.Status}" Value="InvalidTarget">
                                            <Setter Property="Foreground" Value="{StaticResource StatusFailedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Row.Status}" Value="RateLimited">
                                            <Setter Property="Foreground" Value="{StaticResource StatusFailedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Row.Status}" Value="ServerError">
                                            <Setter Property="Foreground" Value="{StaticResource StatusFailedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Row.TimestampText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontTimestamp}"
                                   HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTime}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border CornerRadius="{StaticResource CornerBubble}"
                            Padding="10,8"
                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BubbleMaxWidthConverter}, ConverterParameter=100}"
                            ToolTip="{Binding Row.BubbleToolTip}"
                            ToolTipService.InitialShowDelay="600">
                        <Border.ContextMenu>
                            <!-- ContextMenu(Popup) 는 Window 의 흰색 TextElement.Foreground 상속을 안 받고
                                 WPF 기본 밝은 팝업 배경을 그대로 쓰므로 명시적으로 검은 글자 고정 필요. -->
                            <ContextMenu Foreground="Black">
                                <MenuItem Header="텍스트 복사" Click="CopyMessageMenuItem_OnClick" />
                                <Separator />
                                <MenuItem Header="재전송"
                                          Click="ResendMessageMenuItem_OnClick">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Row.IsMine}" Value="True" />
                                                        <Condition Binding="{Binding Row.Status}" Value="Failed" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Row.IsMine}" Value="True" />
                                                        <Condition Binding="{Binding Row.Status}" Value="ServerError" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Row.IsMine}" Value="True" />
                                                        <Condition Binding="{Binding Row.Status}" Value="InvalidTarget" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Row.IsMine}" Value="True" />
                                                        <Condition Binding="{Binding Row.Status}" Value="RateLimited" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource BubbleTheirBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BubbleTheirBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Row.IsMine}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BubbleMineBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!--: behaviors:LinkifiedText.Text 가 Text 대신 URL 자동 Hyperlink 처리 -->
                        <TextBlock behaviors:LinkifiedText.Text="{Binding Row.Text}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource ChatFontSize}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Row.IsMine}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BubbleMineTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="4,0,0,2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Row.IsMine}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Row.TimestampText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontTimestamp}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTime}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{x:Null}" PreviewMouseDown="RootGrid_OnPreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 커스텀 타이틀바 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceMutedBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Data="{StaticResource IconLogo}" Fill="{StaticResource BrandBrush}" />
                    </Viewbox>
                    <!-- 타이틀바에도 방(상대) 이름을 보여 준다(예전엔 모든 창이 "대화") -->
                    <TextBlock Text="{Binding Text, ElementName=HeaderTitleText}"
                               Margin="8,0,0,0"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TitleMinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="최소화"
                            Click="TitleMinimizeButton_OnClick"
        AutomationProperties.Name="최소화">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="{StaticResource IconMinimize}"
                                  Fill="{StaticResource TextSecondaryBrush}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="TitleMaximizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="최대화"
                            Click="TitleMaximizeButton_OnClick"
        AutomationProperties.Name="최대화">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path x:Name="TitleMaximizeIconPath"
                                  Data="{StaticResource IconMaximize}"
                                  Fill="{StaticResource TextSecondaryBrush}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="TitleCloseButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Tag="Close"
                            ToolTip="닫기"
                            Click="TitleCloseButton_OnClick"
        AutomationProperties.Name="닫기">
                        <Viewbox Width="12" Height="12">
                            <Path Data="{StaticResource IconClose}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TitleCloseButton}" Value="True">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, ElementName=TitleCloseButton}" Value="True">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceMutedBrush}"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0">
                    <Border x:Name="HeaderAvatarBorder" CornerRadius="18" Background="#BDBDBD">
                        <TextBlock x:Name="HeaderAvatarInitial"
                                   Text="?"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Ellipse x:Name="HeaderPresenceDot"
                             Width="10"
                             Height="10"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Stroke="{StaticResource SurfaceMutedBrush}"
                             StrokeThickness="2"
                             Fill="{StaticResource PresenceOfflineBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="상대방"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSection}"
                               AutomationProperties.AutomationId="TalkHeader" />
                    <TextBlock x:Name="HeaderMetaText"
                               Text=""
                               Style="{StaticResource MetaText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HeaderMemberButton"
                            Style="{StaticResource FlatIconButton}"
                            Width="28"
                            Height="28"
                            Visibility="Collapsed"
                            ToolTip="멤버"
                            Click="HeaderMemberButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="TalkHeaderMemberButton"
        AutomationProperties.Name="멤버">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource IconPeople}" Fill="{StaticResource TextSecondaryBrush}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="HeaderSearchButton"
                            Style="{StaticResource FlatIconButton}"
                            Width="28"
                            Height="28"
                            ToolTip="대화 내용 검색"
                            Click="HeaderSearchButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="TalkHeaderSearchButton"
        AutomationProperties.Name="대화 내용 검색">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextSecondaryBrush}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="HeaderMenuButton"
                            Content="⋯"
                            Style="{StaticResource FlatIconButton}"
                            Width="28"
                            Height="28"
                            FontSize="16"
                            ToolTip="대화방 메뉴 (초대·이름 설정·나가기)"
                            Click="HeaderMenuButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="TalkHeaderMenuButton"
                            AutomationProperties.Name="대화방 메뉴" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 초기 로딩 오버레이 — 메시지 리스트와 같은 Grid 셀에 겹침 -->
            <Border Grid.Column="0"
                    x:Name="InitialLoadingOverlay"
                    Background="{StaticResource SurfaceMutedBrush}"
                    Panel.ZIndex="10"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Control Style="{StaticResource AppProgressRing}"
                             Visibility="Visible"
                             Width="32" Height="32" />
                    <TextBlock Text="메시지 불러오는 중..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontMeta}"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 빈 대화방 안내: 메시지가 하나도 없을 때만 -->
            <StackPanel Grid.Column="0"
                        x:Name="EmptyRoomHint"
                        Panel.ZIndex="5"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="EmptyRoomHint">
                <TextBlock Text="아직 주고받은 메시지가 없습니다"
                           FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <!-- 문장 단위로 줄을 나눠 단어 중간("파일 / 도")에서 끊기지 않게 한다 -->
                <TextBlock Text="아래 입력창에 첫 메시지를 써 보세요."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontMeta}"
                           Margin="0,8,0,0"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Text="+ 버튼으로 파일도 보낼 수 있습니다."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontMeta}"
                           Margin="0,2,0,0"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox Grid.Column="0"
                     x:Name="TalkMessagesListBox"
                     BorderThickness="0"
                     Background="{StaticResource SurfaceMutedBrush}"
                     Padding="12,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     ItemTemplate="{StaticResource MessageBubbleTemplate}"
                     Loaded="TalkMessagesListBox_OnLoaded"
                     Focusable="True"
                     IsTabStop="True"
                     KeyboardNavigation.TabNavigation="Once"
                     PreviewMouseLeftButtonDown="TalkMessagesListBox_OnPreviewMouseLeftButtonDown"
                     MouseDoubleClick="TalkMessagesListBox_OnMouseDoubleClick"
                     PreviewKeyDown="TalkMessagesListBox_OnKeyDown"
                     AutomationProperties.Name="메시지 목록"
                     AutomationProperties.AutomationId="TalkMessagesListBox">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <!-- x:Name 필수 — 이름 없으면 메시지 리스트 항목마다 이 TranslateTransform 을
                                     frozen 공유 객체로 최적화해, 메시지가 2개 이상 동시에 Loaded 되면
                                     "변경할 수 없는 개체 인스턴스" 예외로 크래시 -->
                                <TranslateTransform x:Name="MsgSlideTransform" Y="8" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <!-- 선택된 행(클릭 또는 위/아래 키)은 옅게 강조 — 파일 행을 고른 뒤 Enter 로 받을 수 있게 -->
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowBg" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#14FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!--: 새 메시지(또는 history 항목) Loaded 시 fade-in + slide-up. -->
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="8" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Button Grid.Column="0"
                    x:Name="NewMessageBadgeButton"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="NewMessageBadgeButton_OnClick"
                    AutomationProperties.AutomationId="TalkNewMessageBadge"
        AutomationProperties.Name="새 메시지로 이동">
                <Border Background="{StaticResource NewMessageBadgeBgBrush}"
                        CornerRadius="{StaticResource CornerLarge}"
                        Padding="14,8">
                    <TextBlock x:Name="NewMessageBadgeText"
                               Text="↓ 새 메시지 0건"
                               Foreground="{StaticResource NewMessageBadgeFgBrush}"
                               FontSize="{StaticResource FontMeta}"
                               FontWeight="SemiBold" />
                </Border>
            </Button>

        </Grid>

        <!-- 2026-09-17: 카카오톡 PC 대화상대 목록 팝업과 같은 형태로 변경 — 대화 영역 폭을
             밀어내던 사이드 드로어(폭 애니메이션) 대신, 멤버 버튼 아래에 뜨는 카드형 팝업으로
             전환한다. StaysOpen=False 라 바깥을 클릭하면 자동으로 닫힌다. -->
        <Popup x:Name="MemberPopup"
               PlacementTarget="{Binding ElementName=HeaderMemberButton}"
               Placement="Bottom"
               HorizontalOffset="-180"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="220"
                    MaxHeight="360"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerLarge}"
                    Padding="0,8"
                    AutomationProperties.AutomationId="TalkMemberDrawer">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock x:Name="DrawerHeaderText"
                               DockPanel.Dock="Top"
                               Text="멤버 (0)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontMeta}"
                               Margin="14,2,14,6" />
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <Button Content="+ 대화상대 초대하기"
                                    Style="{StaticResource FlatListButton}"
                                    HorizontalContentAlignment="Left"
                                    Padding="14,10"
                                    Click="PopupInviteButton_OnClick" />
                            <Button x:Name="DrawerLeaveButton"
                                    Content="대화방 나가기"
                                    Style="{StaticResource FlatListButton}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    HorizontalContentAlignment="Left"
                                    Padding="14,10"
                                    Click="DrawerLeaveButton_OnClick" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="MemberListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="220"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="MemberListBox_OnMouseDoubleClick"
                             AutomationProperties.AutomationId="TalkMemberListBox">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="16"
                                            Margin="0,0,10,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding AvatarColorHex}" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding AvatarInitial}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontBody}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <StackPanel>
                <Border x:Name="AttachmentPreview"
                        Visibility="Collapsed"
                        Background="{StaticResource AttachmentPreviewBgBrush}"
                        BorderBrush="{StaticResource AttachmentPreviewBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerSmall}"
                        Padding="8,6"
                        Margin="0,0,0,6"
                        AutomationProperties.AutomationId="TalkAttachmentPreview">
                    <DockPanel>
                        <TextBlock x:Name="AttachmentPreviewText"
                                   Text="📎 file.txt (0 KB)"
                                   FontSize="{StaticResource FontMeta}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="AttachmentCancelButton"
                                Content="✕"
                                DockPanel.Dock="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Cursor="Hand"
                                Click="AttachmentCancelButton_OnClick"
                                AutomationProperties.AutomationId="TalkAttachmentCancelButton" />
                    </DockPanel>
                </Border>

                <!-- 카톡식: 입력란이 상단에 전체 폭으로 크게, 첨부/전송 버튼은 그 아래 툴바 줄에 좌/우 배치 -->
                <TextBox x:Name="TalkInputBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="48"
                         MaxHeight="160"
                         MaxLength="4000"
                         Padding="4,10"
                         Margin="0,0,0,4"
                         FontFamily="{StaticResource AppFontFamily}"
                         FontSize="{DynamicResource ChatFontSize}"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         PreviewKeyDown="TalkInputBox_OnPreviewKeyDown"
                         AutomationProperties.AutomationId="TalkInputTextBox"
        AutomationProperties.Name="메시지 입력" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="AttachButton"
                            Style="{StaticResource FlatIconButton}"
                            Width="36"
                            Height="36"
                            ToolTip="파일 첨부 (Ctrl+U)"
                            Click="AttachButton_OnClick"
                            AutomationProperties.AutomationId="TalkAttachButton"
        AutomationProperties.Name="파일 첨부">
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextSecondaryBrush}" />
                        </Viewbox>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="SendButton"
                            Content="전송"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="70"
                            Click="SendButton_OnClick"
                            AutomationProperties.AutomationId="TalkSendButton" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 대화 상대 미정 상태 오버레이 — 타이틀바(Row 0)만 빼고 전부 덮어서 초대 버튼 외
             모든 조작(입력란/전송/헤더 버튼 등)을 차단한다. -->
        <Border x:Name="PendingInviteOverlay"
                Grid.Row="1" Grid.RowSpan="3"
                Background="{StaticResource SurfaceMutedBrush}"
                Panel.ZIndex="50"
                Visibility="Collapsed">
            <Button x:Name="InviteCounterpartButton"
                    Content="대화 상대 초대하기"
                    Style="{StaticResource PrimaryButton}"
                    Width="180"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="InviteCounterpartButton_OnClick"
                    AutomationProperties.AutomationId="TalkInviteCounterpartButton" />
        </Border>
    </Grid>
</Window>
