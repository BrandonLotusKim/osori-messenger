<Window x:Class="OsoriClient.Wpf.MessageRecipientPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="수신자 선택"
        Width="380" Height="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="HeaderTitleText" Text="수신자 선택"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1" x:Name="CloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Tag="Close"
                        ToolTip="닫기"
                        Click="CancelButton_OnClick"
        AutomationProperties.Name="닫기">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconClose}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, ElementName=CloseButton}" Value="True">
                                            <Setter Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBox x:Name="FilterBox"
                     Style="{StaticResource AppTextBox}"
                     Tag="이름 · 아이디 · 부서 검색"
                     ToolTip="이름/아이디/부서로 거르기"
                     TextChanged="FilterBox_OnTextChanged"
        AutomationProperties.Name="이름 또는 아이디 검색" />
        </Border>

        <ListBox Grid.Row="2" x:Name="MemberList"
                 BorderThickness="0"
                 Background="{StaticResource SurfaceBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontMeta}" />
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,2,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding DisplayName}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding DisplayName}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="SelectedCountText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontMeta}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="취소"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="CancelButton_OnClick" />
                <Button Grid.Column="2" x:Name="OkButton" Content="확인"
                        Style="{StaticResource PrimaryButton}"
                        Click="OkButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
