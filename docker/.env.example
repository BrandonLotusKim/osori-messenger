# 오소리 메신저 운영 환경변수 — docker-compose.prod.yml 용
#
# 사용법: cp .env.example .env  → 실제 값 채우기

# ───────── DB ─────────
OSORI_DB_NAME=osori
OSORI_DB_USER=osori
# !!! 실제 비밀번호로 교체. 운영은 충분히 긴 랜덤 문자열 사용 권장.
OSORI_DB_PASS=changeme_with_strong_pw

# ───────── 인증 ─────────
# OPEN = MVP 자동 가입 모드 (비밀번호 검증 없음, 개발/내부 테스트 전용)
# STRICT = Argon2id 실인증 (운영 권장)
OSORI_AUTH_MODE=STRICT

# ───────── Rate limit ─────────
OSORI_RATE_LIMIT_PER_USER_PER_SEC=5

# ───────── 바인드 호스트 ─────────
# 외부에서도 접속 가능하게 하려면 0.0.0.0
# 로컬만 허용하려면 127.0.0.1
OSORI_BIND_HOST=0.0.0.0

# ───────── TLS ─────────
# true 로 켜기 전에 docker/certs/keystore.jks 가 있어야 함.
# 발급 절차는 docker/TLS.md 참고.
OSORI_TLS_ENABLED=false
OSORI_KEYSTORE_PASSWORD=
OSORI_KEY_ALIAS=osori
OSORI_KEY_PASSWORD=

# ───────── JVM 옵션 ─────────
# 운영 환경 메모리에 맞춰 조정
JAVA_OPTS=-Xms256m -Xmx1g

# ───────── 백업 ─────────
# 며칠 분 보존? (그보다 오래된 dump 파일은 매일 자동 삭제)
BACKUP_RETAIN_DAYS=14

# ───────── 알람 webhook ─────────
# 디스크 잔여 부족 등 임계 이벤트가 Slack 채널로 통지된다. 비워두면 WARN 로그만.
# Slack workspace → Apps → Incoming Webhooks 에서 발급.
OSORI_ALARM_SLACK_WEBHOOK=

# ───────── 첨부 보존 ─────────
OSORI_FILE_RETENTION_DAYS=90
OSORI_DISK_ALARM_RATIO=0.05

# ───────── Rate limit 면제 사용자 ─────────
# 쉼표 또는 공백 구분. 시스템 계정, 봇 등을 이 목록에 추가하면 토큰 버킷 우회.
OSORI_RATE_LIMIT_EXEMPT_USERS=
